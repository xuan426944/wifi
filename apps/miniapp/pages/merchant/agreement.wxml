<view class="page" data-phase="10">
  <view class="title">商户协议</view>
  <view wx:if="{{state === 'loading'}}">{{loadingText}}</view>
  <view wx:if="{{state === 'empty'}}">{{emptyText}}</view>
  <view wx:if="{{state === 'error'}}">{{errorText}}</view>
  <view wx:if="{{state === 'forbidden'}}">{{forbiddenText}}</view>
  <view wx:for="{{clauses}}" wx:key="*this">{{item}}</view>
  <button bindtap="onBackTap">同意并返回</button>
</view>
