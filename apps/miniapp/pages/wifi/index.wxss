.page {
  min-height: 100vh;
  background: #f6f7f9;
  color: #18202a;
  padding: 56rpx 36rpx;
  box-sizing: border-box;
}

.wifi-main {
  padding-top: 96rpx;
}

.store-name {
  font-size: 44rpx;
  font-weight: 600;
  line-height: 1.35;
}

.wifi-name {
  margin-top: 20rpx;
  font-size: 30rpx;
  color: #4a5565;
}

.notice,
.state-text {
  margin-top: 28rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #697386;
}

.primary-action,
.secondary-action {
  width: 100%;
  height: 96rpx;
  margin-top: 44rpx;
  border-radius: 8rpx;
  font-size: 32rpx;
}

.primary-action {
  background: #107c41;
  color: #fff;
}

.secondary-action {
  background: #fff;
  color: #18202a;
}

.privacy-link {
  position: fixed;
  left: 36rpx;
  bottom: 36rpx;
  font-size: 24rpx;
  color: #6b7280;
}

.merchant-entry {
  position: fixed;
  right: 36rpx;
  bottom: 36rpx;
  min-width: 132rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  border-radius: 28rpx;
  background: #fff;
  color: #475569;
  font-size: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.08);
}
